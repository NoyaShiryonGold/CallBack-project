<Window x:Class="WpfChatUser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfChatUser"
        Title="Chat Application"
        Height="500" Width="600"
        Background="#ECE5DD">
    
    <Window.Resources>
        <local:MessageAlignmentConverter x:Key="AlignConverter"/>
        <local:MessageBackgroundConverter x:Key="BgConverter"/>
    </Window.Resources>
    
    <Grid>

        <!-- ===== LOGIN ===== -->
        <Grid x:Name="gridLogin"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Width="300">

            <StackPanel>

                <TextBlock Text="Chat Application"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBox x:Name="txtUsername"
                         Padding="10"
                         FontSize="14"
                         Margin="0,0,0,10"
                         KeyDown="txtUsername_KeyDown"/>

                <TextBlock x:Name="lblError"
                           Foreground="Red"
                           Visibility="Collapsed"
                           Margin="0,0,0,10"/>

                <Button x:Name="btnLogin"
                        Content="Enter"
                        Padding="10"
                        Click="btnLogin_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#007ACC"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#005F9E"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Grid>

        <!-- ===== CHAT ===== -->
        <Grid x:Name="gridChat" Visibility="Collapsed">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- ===== USERS ===== -->
            <Border Grid.Column="0" Background="#F7F7F7">

                <DockPanel>

                    <TextBlock Text="Online Users"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="10"
                               DockPanel.Dock="Top"/>

                    <ListBox x:Name="lstUsers"
                             FontSize="25"
                             DisplayMemberPath="Username"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="lstUsers_SelectionChanged"/>

                </DockPanel>
            </Border>

            <!-- ===== MESSAGES ===== -->
            <Grid Grid.Column="1" Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <TextBlock x:Name="lblChatWith"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#333"
                           Margin="0,0,0,10"
                           Text="Select a user"/>

                <!-- CHAT -->
                <ListBox x:Name="lstMessages"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5,4">
                                <Border CornerRadius="15"
                    Padding="10"
                    MaxWidth="300">

                                    <!-- ALIGN -->
                                    <Border.HorizontalAlignment>
                                        <MultiBinding Converter="{StaticResource AlignConverter}">
                                            <Binding Path="Sender.Id"/>
                                            <Binding Path="DataContext.Id"
         RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </Border.HorizontalAlignment>

                                    <!-- COLOR -->
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource BgConverter}">
                                            <Binding Path="Sender.Id"/>
                                            <Binding Path="DataContext.Id"
         RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </Border.Background>

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8"
                                      ShadowDepth="2"
                                      Opacity="0.15"/>
                                    </Border.Effect>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Sender.Username}"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="#007ACC"/>

                                        <TextBlock Text="{Binding Text}"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Margin="0,5"/>

                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                               FontSize="9"
                               Foreground="Gray"
                               HorizontalAlignment="Right"/>
                                    </StackPanel>

                                </Border>

                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

                <!-- SEND -->
                <Grid Grid.Row="2" Margin="0,10,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtMessageInput"
                             Padding="10"
                             FontSize="14"
                             Background="White"
                             BorderBrush="#DDD"
                             BorderThickness="1"
                             KeyDown="txtMessageInput_KeyDown"/>

                    <Button Grid.Column="1"
                            Content="➤"
                            Click="btnSend_Click"
                            FontSize="18"
                            Margin="5,0,0,0"
                            Background="#007ACC"
                            Foreground="White"
                            BorderThickness="0"/>

                </Grid>

            </Grid>

        </Grid>

    </Grid>
</Window>